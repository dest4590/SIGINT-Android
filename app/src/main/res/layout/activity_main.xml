<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingBottom="2dp"
            android:text="SIGINT"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS: IDLE"
            android:textColor="@color/gray_light"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/white"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/gray_light"
            app:tabMode="fixed"
            android:background="@color/gray_dark"
            android:padding="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/scan_button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:text="START SCAN"
                android:backgroundTint="@color/gray_dark"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/pause_button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="PAUSE"
                android:visibility="gone"
                android:backgroundTint="@color/gray_dark"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/clear_button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="CLEAR"
                android:backgroundTint="@color/gray_dark"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/sync_button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="SYNC"
                android:backgroundTint="@color/gray_dark"
                android:textColor="@color/white"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="Search name / vendor / id…"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_light"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="@color/gray_dark"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/sort_spinner"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@color/gray_dark"
                android:textColor="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/device_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stats_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL: 0 devices"
                    android:textColor="@color/white"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:paddingBottom="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waiting for scan..."
                    android:fontFamily="monospace"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:padding="12dp"
                    android:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/device_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:overScrollMode="always"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/stats_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DATABASE SETTINGS"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:paddingBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/stats_detail_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No data yet."
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BACKEND URL"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="16dp"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/backend_url_input"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="http://192.168.1.100:8000"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray_light"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@color/gray_dark"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:inputType="textUri"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="API KEY"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:layout_marginTop="12dp"
                        android:paddingBottom="4dp" />

                    <EditText
                        android:id="@+id/api_key_input"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Enter API Key"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray_light"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="@color/gray_dark"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <CheckBox
                        android:id="@+id/sync_on_start_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sync on Start"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:buttonTint="@color/white" />

                    <CheckBox
                        android:id="@+id/autosync_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Autosync while scanning"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"
                        android:buttonTint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interval (min): "
                            android:textColor="@color/white"
                            android:fontFamily="monospace"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/autosync_interval_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@color/gray_dark" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/keep_screen_on_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keep Screen On"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp"
                        android:buttonTint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RSSI Filter: "
                            android:textColor="@color/white"
                            android:fontFamily="monospace"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/rssi_filter_spinner"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@color/gray_dark" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/export_db_button"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="EXPORT DB"
                        android:backgroundTint="@color/gray_dark"
                        android:textColor="@color/white"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/log_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOG OUTPUT"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/log_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="always"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>